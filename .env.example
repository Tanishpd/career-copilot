# Copy to .env and fill in with real values. .env is gitignored — never commit it.
# The values below are dummies showing the expected shape.

# ── Google Gemini ────────────────────────────────────────────────────────
# https://aistudio.google.com/apikey  (39 chars, starts with AIza)
GEMINI_API_KEY=AIzaSyDUMMY_REPLACE_ME_0000000000000000000

# ── MySQL ────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=change_me_before_running
MYSQL_DB=quizapp

# ── Mail (Gmail SMTP) ────────────────────────────────────────────────────
# MAIL_PASSWORD is a Gmail *app password*, not your account password:
# https://myaccount.google.com/apppasswords  (16 chars, no spaces)
MAIL_USERNAME=your_address@gmail.com
MAIL_PASSWORD=abcdefghijklmnop

# ── Flask ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace_with_a_random_64_char_hex_string
